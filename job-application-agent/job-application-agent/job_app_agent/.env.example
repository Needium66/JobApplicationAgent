# Copy to job_app_agent/.env for local runs:  cp job_app_agent/.env.example job_app_agent/.env
# --- Gemini via Google Cloud (Vertex AI / Gemini Enterprise Agent Platform) ---
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your_project_id
# Gemini 3.x models are served from the global endpoint
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.8-flash

# --- Infrastructure (leave DOCS_BUCKET empty + JOB_AGENT_LOCAL_ONLY=true to work fully offline) ---
DOCS_BUCKET=your_bucket
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=applications
JOB_AGENT_LOCAL_ONLY=false

# --- Optional email submission via Gmail API (README step 9) ---
APPLY_EMAIL_ENABLED=false
GMAIL_TOKEN_SECRET=gmail-oauth-token
APPLICANT_EMAIL=
