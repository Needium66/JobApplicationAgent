# Local run (python -m jobpilot.local): copy to jobpilot/.env
# Gemini via Google Cloud. Gemini 3.x is served from the global endpoint.
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Local mode keeps everything in memory; these stay as-is.
BACKEND=local
AUTH_MODE=dev
